# AstroCyberr Monopoly v5.0 — Environment Variables Template
# Copy this file to `.env` and fill in your Supabase project credentials.
# Never commit your real `.env` file to version control.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Optional: Comma-separated list of authorized Admin emails for `/admin`
# Primary enforcement MUST be configured via Supabase RLS policies on `public.monopoly_config`.
VITE_ADMIN_EMAILS=admin1@example.com,admin2@example.com
